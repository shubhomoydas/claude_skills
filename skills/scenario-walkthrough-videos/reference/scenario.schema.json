{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scenario-walkthrough-videos/scenario.schema.json",
  "x-version": "1.3",
  "title": "Scenario walk-through",
  "description": "The contract between whoever produces a walk-through scenario and the skill that renders it. Versioned: x-version is this schema's version; a scenario states the version it was written for in schema_version. Minor changes only add optional fields; a major change breaks. See reference/scenario-format.md.",
  "type": "object",
  "required": [
    "meta",
    "style",
    "sources",
    "entities",
    "initial_state",
    "layout",
    "frames"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "MAJOR.MINOR of the contract the scenario was written for; absent means 1.0."
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "width",
        "height",
        "fps",
        "default_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "width": {
          "type": "integer",
          "minimum": 640,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 360,
          "maximum": 2160
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "default_seconds": {
          "type": "number",
          "minimum": 1
        },
        "crossfade_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "output_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title_height": {
              "type": "integer",
              "minimum": 60,
              "maximum": 200
            },
            "caption_height": {
              "type": "integer",
              "minimum": 60,
              "maximum": 300
            },
            "caption_max_lines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "top_margin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300,
              "description": "Blank strip at the top of every frame in px (1.3), kept free because the Mac player overlays window buttons and the title there. Default 32 px per 720 px of height (48 on 1080); the validator warns below 24 per 720 (36 on 1080). Until 2026-10-25 the default was 64 per 720; the field and range are unchanged. The drawing is scaled into the space below it."
            },
            "note_font_size": {
              "type": "integer",
              "minimum": 12,
              "maximum": 36,
              "description": "Font size in px of the text in notes, callouts and before/after boxes (1.1). Default 21; schema 1.0 drew 18."
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sans": {
              "type": "string"
            },
            "mono": {
              "type": "string"
            },
            "char_width": {
              "type": "object",
              "required": [
                "sans",
                "sans_bold",
                "mono"
              ],
              "additionalProperties": false,
              "properties": {
                "sans": {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 1
                },
                "sans_bold": {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 1
                },
                "mono": {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 1
                }
              }
            }
          }
        },
        "notes": {
          "type": "string"
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "description": "Settings of the optional narration track (1.1).",
          "properties": {
            "voice": {
              "type": "string",
              "pattern": "^[a-z]{2}_[a-z]+$",
              "description": "Kokoro voice, for example af_heart."
            },
            "speed": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2,
              "description": "Speaking speed; 1.0 is normal."
            },
            "pause_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "description": "Silence kept after a narration before the next frame."
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[A-Za-z]{2})?$",
              "description": "Language code of the narration, for example en-us. Voice and language must agree."
            }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "badges",
        "arrows",
        "highlights",
        "callouts"
      ],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/color"
          }
        },
        "entity_colors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/color"
          }
        },
        "color_maps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/color"
            }
          }
        },
        "badges": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "fill",
              "text",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "fill": {
                "$ref": "#/definitions/color"
              },
              "text": {
                "$ref": "#/definitions/color"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "unbuilt": {
                "type": "boolean"
              },
              "sources_optional": {
                "type": "boolean"
              }
            }
          }
        },
        "arrows": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/line_style"
          }
        },
        "highlights": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/line_style"
          }
        },
        "callouts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "fill",
              "border",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "fill": {
                "$ref": "#/definitions/color"
              },
              "border": {
                "$ref": "#/definitions/color"
              },
              "text": {
                "$ref": "#/definitions/color"
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/ident"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          },
          "read_on": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "code",
              "design",
              "document",
              "measurement",
              "interview",
              "example"
            ]
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fields",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string"
                },
                "enum": {
                  "type": "array",
                  "minItems": 1
                },
                "nullable": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "op",
          "entity",
          "when",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/ident"
          },
          "op": {
            "type": [
              "string",
              "array"
            ]
          },
          "entity": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "when": {
            "type": "object"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "panels"
      ],
      "additionalProperties": false,
      "properties": {
        "panels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/panel"
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/frame"
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "ident": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "line_style": {
      "type": "object",
      "required": [
        "color",
        "width"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/definitions/color"
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "dash": {
          "type": "string"
        }
      }
    },
    "region": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "entity",
        "region",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/ident"
        },
        "kind": {
          "enum": [
            "table",
            "board",
            "graph"
          ]
        },
        "entity": {
          "type": "string"
        },
        "region": {
          "$ref": "#/definitions/region"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "color": {
          "$ref": "#/definitions/color"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "width"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "header": {
                "type": "string"
              },
              "width": {
                "type": "number",
                "minimum": 20
              },
              "font": {
                "enum": [
                  "sans",
                  "mono"
                ]
              },
              "color_map": {
                "type": "string"
              }
            }
          }
        },
        "row_height": {
          "type": "number",
          "minimum": 18,
          "maximum": 80
        },
        "font_size": {
          "type": "number",
          "minimum": 10,
          "maximum": 28
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "enum": [
            "insert",
            "newest_first"
          ]
        },
        "window": {
          "type": "integer",
          "minimum": 1
        },
        "lane_field": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "minItems": 1
        },
        "lane_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "lanes_from": {
          "type": "object",
          "required": [
            "entity"
          ],
          "additionalProperties": false,
          "properties": {
            "entity": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "null_lane": {
          "type": "string"
        },
        "lane_color_map": {
          "type": "string"
        },
        "chip_label": {
          "type": "string"
        },
        "chip_width": {
          "type": "number",
          "minimum": 24,
          "maximum": 200
        },
        "chip_color_field": {
          "type": "string"
        },
        "color_map": {
          "type": "string"
        },
        "x_field": {
          "type": "string"
        },
        "y_field": {
          "type": "string"
        },
        "radius_field": {
          "type": "string"
        },
        "point_color_field": {
          "type": "string"
        },
        "point_label": {
          "type": "string"
        },
        "show_coords": {
          "type": "boolean"
        },
        "circle_color": {
          "$ref": "#/definitions/color"
        },
        "domain": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "y": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "plot": {
          "$ref": "#/definitions/region"
        },
        "edges_entity": {
          "type": "string"
        },
        "edge_from": {
          "type": "string"
        },
        "edge_to": {
          "type": "string"
        },
        "edge_weight": {
          "type": "string"
        },
        "edge_state": {
          "type": "string"
        },
        "edge_label_pos": {
          "type": "string"
        },
        "edge_styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "$ref": "#/definitions/color"
              },
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 12
              },
              "dash": {
                "type": "string"
              },
              "label": {
                "type": "boolean"
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "columns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "board"
              }
            }
          },
          "then": {
            "required": [
              "lane_field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "graph"
              }
            }
          },
          "then": {
            "required": [
              "x_field",
              "y_field",
              "edges_entity",
              "domain"
            ]
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "required": [
        "id",
        "step",
        "title",
        "caption",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/ident"
        },
        "step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "status": {
          "type": "object",
          "required": [
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "string"
            },
            "detail": {
              "type": "string",
              "maxLength": 110
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/transition"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/annotation"
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "columns",
            "widths",
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "widths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 40
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "status_column": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "notes": {
          "type": "string"
        },
        "caption_only": {
          "type": "boolean"
        },
        "narration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Spoken text for this frame (1.1). Written as speech: numbers in words, no paths or code. Optional; frames without it are silent."
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "op",
        "entity"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "add_row",
            "update_row",
            "set_field",
            "move_row",
            "delete_row"
          ]
        },
        "entity": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "ids": {
          "type": "array",
          "minItems": 1
        },
        "where": {
          "type": "object"
        },
        "row": {
          "type": "object"
        },
        "set": {
          "type": "object"
        },
        "field": {
          "type": "string"
        },
        "value": {},
        "to": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "expect_refused": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "add_row"
              }
            }
          },
          "then": {
            "required": [
              "row"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "update_row"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "set"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "set_field"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "field",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "move_row"
              }
            }
          },
          "then": {
            "required": [
              "field",
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "delete_row"
              }
            }
          },
          "then": {
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "annotation": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "arrow",
            "highlight",
            "callout",
            "badge",
            "before_after",
            "tint",
            "note"
          ]
        },
        "id": {
          "$ref": "#/definitions/ident"
        },
        "style": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "text": {
          "type": "string",
          "maxLength": 300
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 120
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "allow_overlap": {
          "type": "boolean"
        },
        "arrow_style": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "highlight": {
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "arrow"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "to",
              "style"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "highlight"
